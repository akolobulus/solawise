# Copy to .env.local and fill in values from the Pollar and Supabase dashboards.
# Use matching test-mode keys for Solana devnet. The publishable key is browser-visible;
# the secret key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=
# Supabase project URL and publishable key. Never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Create a key at console.groq.com; never use NEXT_PUBLIC_ here.
GROQ_API_KEY=
# Optional: override the default supported Groq chat model.
GROQ_MODEL=openai/gpt-oss-120b
# Server-side only. Used to generate spoken Assistant replies; never expose with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Override only when testing with another classic SPL mint on devnet.
NEXT_PUBLIC_SOLAWISE_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
https://faucet.solana.com/