# Copy to .env.local and fill in the values from dashboard.pollar.xyz.
# Use matching test-mode keys for Solana devnet. The publishable key is browser-visible;
# the secret key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=
# Override only when testing with another classic SPL mint on devnet.
NEXT_PUBLIC_SOLAWISE_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
